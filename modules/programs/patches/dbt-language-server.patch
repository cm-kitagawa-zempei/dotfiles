+// LSP の character は UTF-16 単位で届くが、パーサの列はバイト単位なので変換する
+func utf16ToByteOffset(line string, col int) int {
+	units := 0
+	for i, r := range line {
+		if units >= col {
+			return i
+		}
+		if r >= 0x10000 {
+			units += 2
+		} else {
+			units++
+		}
+	}
+	return len(line)
+}
+
+func (s *State) toBytePosition(uri string, pos lsp.Position) lsp.Position {
+	lines := strings.Split(s.Documents[uri].Text, "\n")
+	if pos.Line < 0 || pos.Line >= len(lines) {
+		return pos
+	}
+	pos.Character = utf16ToByteOffset(lines[pos.Line], pos.Character)
+	return pos
+}
+
+// {{ の直後以外（{% set x = m() %} や 'a' ~ m() など）のマクロ呼び出しを解決する
+func (s *State) findMacroCall(uri string, tl *parser.TokenLL) (Macro, bool) {
+	tok := tl.Token
+	lines := strings.Split(s.Documents[uri].Text, "\n")
+	if tok.Line < 0 || tok.Line >= len(lines) {
+		return Macro{}, false
+	}
+	line := lines[tok.Line]
+	end := tok.Column + len(tok.Literal)
+	if end > len(line) || !strings.HasPrefix(strings.TrimLeft(line[end:], " \t"), "(") {
+		return Macro{}, false
+	}
+	prev := tl.PrevToken
+	if prev != nil && prev.Token.Type == parser.DOT && prev.PrevToken != nil {
+		m, ok := s.DbtContext.MacroDetailMap[Package(prev.PrevToken.Token.Literal)][tok.Literal]
+		return m, ok
+	}
+	project := Package(s.DbtContext.ProjectYaml.ProjectName.Value)
+	if m, ok := s.DbtContext.MacroDetailMap[project][tok.Literal]; ok {
+		return m, true
+	}
+	for _, macros := range s.DbtContext.MacroDetailMap {
+		if m, ok := macros[tok.Literal]; ok {
+			return m, true
+		}
+	}
+	return Macro{}, false
+}
