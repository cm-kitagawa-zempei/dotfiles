+// snapshot は {% snapshot <name> %} ブロックの名前で ref される
+func createSnapshotPathMap(projectRoot string, projYaml DbtProjectYaml) map[string]string {
+	snapshotRegex := regexp.MustCompile(`\{%-?\s*snapshot\s+(\w+)`)
+	snapshots := make(map[string]string)
+	for _, p := range projYaml.SnapshotPaths.Value {
+		paths, err := util.WalkFilepath(filepath.Join(projectRoot, p), ".sql")
+		if err != nil {
+			continue
+		}
+		for _, path := range paths {
+			contents, err := util.ReadFileContents(path)
+			if err != nil {
+				continue
+			}
+			for _, m := range snapshotRegex.FindAllStringSubmatch(contents, -1) {
+				snapshots[m[1]] = path
+			}
+		}
+	}
+	return snapshots
+}
